{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shortlinks",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // The admin panel (the React app built by Vite) is served at /admin. The Worker runs first on every
  // /admin request so its Cloudflare Access check covers the panel's files as well as the API.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*"]
  },
  "vars": {
    // Sites a link may point to, separated by commas.
    "ALLOWED_HOSTS": "ianmenethil.com",
    // Company name shown in the admin panel.
    "BRAND_NAME": "Menethil",
    // Cloudflare Access protecting /admin: your team domain and the application's AUD tag.
    // The admin panel refuses every request until both are set.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  // No id: Wrangler creates the namespace on the first deploy.
  "kv_namespaces": [{ "binding": "LINKS" }],
  // 100 requests per minute for each visitor on /s/* and 100 on /links, counted separately in each Cloudflare location.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }],
  "secrets": { "required": ["LINKS_ADMIN_TOKEN"] },
  // Local development only: simulates a signed-in Access user so /admin works under `pnpm run dev`.
  "access": { "dev": { "aud": "local-dev", "identity": { "email": "admin@ianmenethil.com" } } }
}
